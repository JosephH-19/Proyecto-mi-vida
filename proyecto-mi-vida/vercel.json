{
  "version": 2,
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static",
      "config": { "distDir": "." }
    },
    {
      "src": "css/**/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "js/**/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "$1",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "cleanUrls": true
}
